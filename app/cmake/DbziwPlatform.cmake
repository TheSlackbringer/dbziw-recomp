# Compiler and platform options shared by the dbziw targets.
# With GCC-style compilers (the Linux build) these expand to -march=x86-64-v3 and, for lifted code,
# -frounding-math -ffp-contract=off.

if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    set(DBZIW_ARCH_FLAGS -march=x86-64-v3)
    set(DBZIW_STRICT_FP_FLAGS /clang:-frounding-math /clang:-ffp-contract=off)
elseif(MSVC)
    set(DBZIW_ARCH_FLAGS /arch:AVX2)
    set(DBZIW_STRICT_FP_FLAGS /fp:strict)
else()
    set(DBZIW_ARCH_FLAGS -march=x86-64-v3)
    set(DBZIW_STRICT_FP_FLAGS -frounding-math -ffp-contract=off)
endif()

# Windows-only target settings; a no-op elsewhere.
function(dbziw_windows_target_options target)
    if(NOT WIN32)
        return()
    endif()
    get_target_property(target_type ${target} TYPE)
    if(MSVC)
        target_compile_options(${target} PRIVATE /bigobj)
        if(target_type STREQUAL "EXECUTABLE")
            target_link_options(${target} PRIVATE /STACK:16777216 /FORCE:MULTIPLE /MANIFEST:NO)
        endif()
    elseif(target_type STREQUAL "EXECUTABLE")
        target_link_options(${target} PRIVATE -Wl,--stack,16777216)
    endif()
    if(target_type STREQUAL "EXECUTABLE")
        if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../tools/windows/utf8.rc")
            target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../tools/windows/utf8.rc")
        endif()
    endif()
    if(target_type STREQUAL "EXECUTABLE")
        dbziw_runtime_dlls_target()
        add_dependencies(${target} dbziw_runtime_dlls)
    endif()
endfunction()

function(dbziw_runtime_dlls_target)
    if(TARGET dbziw_runtime_dlls)
        return()
    endif()
    set(dest "${CMAKE_CURRENT_BINARY_DIR}")
    set(commands)
    if(PS2X_FFMPEG_BIN_DIR AND PS2X_COPY_FFMPEG_DLLS_SCRIPT)
        list(APPEND commands COMMAND "${CMAKE_COMMAND}" "-Dsource_dir=${PS2X_FFMPEG_BIN_DIR}" "-Ddest_dir=${dest}"
             -P "${PS2X_COPY_FFMPEG_DLLS_SCRIPT}")
    endif()
    if(NOT MSVC AND LLVM_MINGW_ROOT)
        list(APPEND commands COMMAND "${CMAKE_COMMAND}" -E copy_if_different
             "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32/bin/libc++.dll"
             "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32/bin/libunwind.dll" "${dest}")
    endif()
    if(NOT commands)
        set(commands COMMAND "${CMAKE_COMMAND}" -E true)
    endif()
    add_custom_target(dbziw_runtime_dlls ALL ${commands} VERBATIM)
    if(TARGET ffmpeg_external)
        add_dependencies(dbziw_runtime_dlls ffmpeg_external)
    endif()
endfunction()
