<?xml version="1.0" encoding="utf-8"?>
<!-- Recording profile (tools/profile). Only what the report needs: CPU samples, thread switches and
     "ready thread" (who woke whom), each with call stacks, plus process/thread/module events for names and
     symbols. No file, disk, registry or network events (privacy). Sampling interval: Windows
     default 1 ms. Used as "dbziw.wprp!DBZIW". -->
<WindowsPerformanceRecorder Version="1.0" Author="dbziw-recomp" Comments="issue 010 profiling">
  <Profiles>
    <SystemCollector Id="SC_DBZIW" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="512"/>
    </SystemCollector>
    <SystemProvider Id="SP_DBZIW">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="SampledProfile"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile"/>
        <Stack Value="CSwitch"/>
        <Stack Value="ReadyThread"/>
      </Stacks>
    </SystemProvider>
    <Profile Id="DBZIW.Verbose.File" Name="DBZIW" Description="DBZIW profiling (issue 010)" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC_DBZIW">
          <SystemProviderId Value="SP_DBZIW"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
