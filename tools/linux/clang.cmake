# The release ships this compiler and the Steam Runtime sysroot. No system SDK is needed.
if(NOT DBZIW_LINUX_TOOLCHAIN_ROOT AND DEFINED ENV{DBZIW_LINUX_TOOLCHAIN_ROOT})
    set(DBZIW_LINUX_TOOLCHAIN_ROOT "$ENV{DBZIW_LINUX_TOOLCHAIN_ROOT}" CACHE PATH "Bundled Linux SDK")
endif()
if(NOT DBZIW_LINUX_TOOLCHAIN_ROOT)
    message(FATAL_ERROR "DBZIW_LINUX_TOOLCHAIN_ROOT must point at the bundled tools/clang folder")
endif()
# CMake 3.25's whole-project LTO probes do not copy custom cache variables.
set(ENV{DBZIW_LINUX_TOOLCHAIN_ROOT} "${DBZIW_LINUX_TOOLCHAIN_ROOT}")
set(CMAKE_C_COMPILER "${DBZIW_LINUX_TOOLCHAIN_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${DBZIW_LINUX_TOOLCHAIN_ROOT}/bin/clang++")
set(CMAKE_AR "${DBZIW_LINUX_TOOLCHAIN_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${DBZIW_LINUX_TOOLCHAIN_ROOT}/bin/llvm-ranlib")
set(CMAKE_SYSROOT "${DBZIW_LINUX_TOOLCHAIN_ROOT}/sysroot")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-lc++abi")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
# CMake compiler probes run in their own project; keep the bundled SDK selection.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DBZIW_LINUX_TOOLCHAIN_ROOT)
